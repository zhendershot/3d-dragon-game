{
  "name": "3d-dragon-game",
  "version": "1.0.0",
  "description": "A 3D game where you fly dragons and shoot fireballs",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "three": "^0.162.0",
    "electron-serve": "^1.2.0",
    "simplex-noise": "^4.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.1.6"
  },
  "build": {
    "appId": "com.dragon3d.game",
    "productName": "3D Dragon Game",
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}